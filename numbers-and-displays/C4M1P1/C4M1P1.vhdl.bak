library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity C4M1P1 is port ( 
SW: in std_logic_vector(9 downto 0); 
HEX0, HEX1: out std_logic_vector(7 downto 0) 
); 
end C4M1P1;

architecture behavioral of C4M1P1 is
    function display_number(switch_in : std_logic_vector(3 downto 0)) return std_logic_vector(7 downto 0) is 
    begin
        case switch_in is 
            when "0000" => "00000000";
            when "0001" => "00000001";
            when "0010" => "00000010";
            when "0011" => "00000011";
            when "0100" => "00000100";
            when "0101" => "00000101";
            when "0110" => "00000110";
            when "0111" => "00000111";
            when "1000" => "00001000";
            when "1001" => "00001001";
            when others => "00000000";
        end case;    
    end function;
end behavioral;

HEX1 <= display_number(SW(7 downto 4));
HEX0 <= display_number(SW(3 downto 0));